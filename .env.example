# EmailJS credentials — copy this file to .env.local and fill in your values.
# Find them at https://dashboard.emailjs.com
#   Service ID  -> Email Services
#   Template ID -> Email Templates
#   Public Key  -> Account > General
# These are browser-safe (EmailJS exposes them by design); lock the domain down
# under Account > Security to stop other sites using your quota.
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=
